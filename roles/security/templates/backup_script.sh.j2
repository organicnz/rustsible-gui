#!/bin/bash
# Automated System Backup Script — generated by Ansible.
set -Eeuo pipefail
umask 077

BACKUP_DEST={{ backup_destination | quote }}
RETENTION_DAYS={{ backup_retention_days | int }}
[[ "$BACKUP_DEST" = /* && "$BACKUP_DEST" != / && ! -L "$BACKUP_DEST" ]]
[[ "$RETENTION_DAYS" =~ ^[0-9]+$ ]]
install -d -m 0700 "$BACKUP_DEST"

# Hold the lock through publication and retention. A competing invocation fails.
exec 9>"$BACKUP_DEST/.system-backup.lock"
flock -n 9
# Budget for staging, a worst-case archive and 1 GiB left for the host.
REQUIRED_KB=0
{% for dir in backup_directories %}
SOURCE={{ dir | quote }}
if [[ -d "$SOURCE" ]]; then
    SIZE_KB=$(du -sk -- "$SOURCE" | awk '{print $1}')
    [[ "$SIZE_KB" =~ ^[0-9]+$ ]]
    REQUIRED_KB=$((REQUIRED_KB + SIZE_KB * 2))
fi
{% endfor %}
AVAILABLE_KB=$(df -Pk -- "$BACKUP_DEST" | awk 'NR == 2 {print $4}')
[[ "$AVAILABLE_KB" =~ ^[0-9]+$ ]]
if (( AVAILABLE_KB < REQUIRED_KB + 1048576 )); then
    echo "Backup refused: insufficient space for staging, archive and 1 GiB reserve" >&2
    exit 1
fi
BACKUP_DIR=$(mktemp -d "$BACKUP_DEST/.system-backup.XXXXXXXX")
BACKUP_DATE=$(date -u +%Y%m%dT%H%M%SZ)
ARCHIVE="$BACKUP_DEST/system-backup-${BACKUP_DATE}-${BACKUP_DIR##*.}.tar.gz"
PARTIAL="$BACKUP_DIR/archive.partial"
trap 'status=$?; if (( status != 0 )); then echo "Backup failed; restricted staging preserved: $BACKUP_DIR" >&2; fi' EXIT

mkdir -m 0700 "$BACKUP_DIR/data"
COPIED=0
{% for dir in backup_directories %}
SOURCE={{ dir | quote }}
if [[ -d "$SOURCE" ]]; then
    # --relative preserves the full source path and avoids basename collisions.
    rsync -aR --exclude="/${BACKUP_DEST#/}/***" -- "$SOURCE" "$BACKUP_DIR/data/"
    COPIED=$((COPIED + 1))
else
    echo "Optional backup source absent: $SOURCE" >&2
fi
{% endfor %}

{% if backup_mysql %}
# Missing tools and failed dumps are failures, never successful empty backups.
mysqldump --all-databases --single-transaction > "$BACKUP_DIR/data/mysql_backup.sql"
COPIED=$((COPIED + 1))
{% endif %}

(( COPIED > 0 ))
tar -czf "$PARTIAL" -C "$BACKUP_DIR/data" .
[[ -s "$PARTIAL" ]]
tar -tzf "$PARTIAL" > /dev/null
chmod 0600 "$PARTIAL"
# Unique publication is on the same filesystem; an existing file is never replaced.
ln -- "$PARTIAL" "$ARCHIVE"
rm -rf -- "$BACKUP_DIR"

# Only this producer's completed archives are eligible. Legacy files are preserved.
find "$BACKUP_DEST" -maxdepth 1 -type f \
    -name 'system-backup-????????T??????Z-????????.tar.gz' \
    ! -path "$ARCHIVE" -mtime "+$RETENTION_DAYS" -delete
echo "Backup completed and archive verified: $ARCHIVE"
